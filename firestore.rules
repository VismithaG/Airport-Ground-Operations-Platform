rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - read for any authenticated user, write only by admin or the user themselves
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.uid == userId);
    }

    // Work Orders - any authenticated user can read and write
    match /workOrders/{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
